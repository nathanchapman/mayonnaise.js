{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "paths": {
      "mayonnaise.js": ["./src/mayonnaise.cts"]
    },
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.cts", "src/**/*.mts"],
  "exclude": ["dist", "node_modules"]
}
